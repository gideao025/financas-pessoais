# Copie para .env e ajuste (o .env NÃO deve ser versionado).
# O docker compose carrega o .env automaticamente.

# Perfil de execução: dev | hmlg | prd
#  - dev/hmlg carregam o seed de exemplo
#  - prd NÃO carrega seed e EXIGE um JWT_SECRET forte
SPRING_PROFILES_ACTIVE=dev

# Segredo do JWT. Em prd é obrigatório trocar (o app recusa subir com o default).
# Gere um na docker-vm com:  openssl rand -base64 48
JWT_SECRET=change-me-in-production-change-me-in-production-change-me

# Senha do Postgres (use uma forte em produção).
DB_PASSWORD=financas
